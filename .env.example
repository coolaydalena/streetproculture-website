# Copy to .env.local (repo root) and fill in. Never commit .env.local.

# --- Supabase (public — safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New "publishable" key (sb_publishable_…). Legacy projects: use
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead — the app accepts either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase (secret — server only, NEVER prefixed NEXT_PUBLIC) ---
# New "secret" key (sb_secret_…). Legacy: SUPABASE_SERVICE_ROLE_KEY — either works.
# Used by the checkout server action + the PayMongo webhook (both bypass RLS).
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Site ---
# Local: http://localhost:3000 · Production: https://streetproculture.com
# Preview/staging: the staging domain, so canonical URLs + auth redirects resolve.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PayMongo (secret — server only) ---
# sk_test_… locally + on the staging (Preview) deploy; sk_live_… on Production.
# The sk_ prefix also selects which webhook signature (test/live) is verified.
# In PLATFORM mode this is our PLATFORM (parent) key — the SPC child has no key.
PAYMONGO_SECRET_KEY=sk_test_xxx
# The signing secret of the webhook pointing at <site>/api/paymongo/webhook.
# One secret per environment, shown only once when the webhook is created.
# In platform mode, register the webhook against the CHILD account (events are
# delivered to the child's endpoint) — see scripts/paymongo/onboard-child.mjs.
PAYMONGO_WEBHOOK_SECRET=whsk_test_xxx
# Optional override; defaults to https://api.paymongo.com/v1
# PAYMONGO_API_BASE=https://api.paymongo.com/v1

# --- PayMongo Platforms (optional — set BOTH to run SPC as a child account) ---
# When both are set, checkout calls send `Account-Id: <child>` so transactions,
# ledger and webhooks belong to SPC, and each order's "own fee" is split to the
# platform account. Leave unset to run SPC as a standalone merchant.
# Create the child with: node --env-file=.env.local scripts/paymongo/onboard-child.mjs create
# PAYMONGO_ACCOUNT_ID=org_xxx           # the SPC child account
# PAYMONGO_PLATFORM_ACCOUNT_ID=org_xxx  # our parent/platform account (own-fee recipient)

# --- Cron (server only) ---
# Random 32+ char string. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/expire-orders. Set the same value in Vercel's env for the cron to run.
CRON_SECRET=change-me

# --- Local `supabase start` only (put in supabase/.env, not here) ---
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
